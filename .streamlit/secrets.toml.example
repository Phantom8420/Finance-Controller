# Copy to .streamlit/secrets.toml for local Streamlit-native secrets
# management (an alternative to .env — either works locally, since
# app/dashboard/streamlit_app.py reads via os.environ and both paths end
# up populating it). Never commit the real secrets.toml — it's gitignored.
#
# For Streamlit Community Cloud: paste this same TOML (with real values)
# into the app's Settings -> Secrets in the dashboard. Streamlit Cloud
# injects every key here into os.environ automatically, so no code
# changes are needed between local and deployed.

RAZORPAY_KEY_ID = ""
RAZORPAY_KEY_SECRET = ""
GEMINI_API_KEY = ""
GEMINI_MODEL = "gemini-3.6-flash"
